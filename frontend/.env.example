# Frontend env example for local development
# Google OAuth client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# API base URL used by the frontend (include protocol + host + optional port)
# In development this is typically http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Optional: additional flags
# VITE_APP_FEATURE_FLAG_X=false
