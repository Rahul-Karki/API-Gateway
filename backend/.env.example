# Database
MONGODB_URI=mongodb://localhost:27017/your_database

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Environment
NODE_ENV=development
PORT=5000

# Redis (required for distributed cache + rate limiting)
# Option A: Direct Redis URL (self-hosted / managed Redis)
# REDIS_URL=redis://localhost:6379

# Option B: Upstash REST credentials (auto-converted to rediss:// at runtime)
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
REDIS_REST_TOKEN=your_upstash_redis_rest_token
# Optional override if your provider uses non-default Redis TCP port
# UPSTASH_REDIS_PORT=6379

# Cache tuning (deployment)
# fresh cache TTL is configured in route middleware (e.g. cacheMiddleware(60))
# stale window serves old value briefly while next request refreshes key
CACHE_STALE_SECONDS=30
# jitter spreads expirations to reduce cache stampede across pods/instances
CACHE_TTL_JITTER_SECONDS=10
# SCAN count used for invalidation pattern scans (higher = faster, more CPU)
CACHE_SCAN_COUNT=500

# Logging
LOG_LEVEL=info

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CORS: comma-separated list of allowed origins (protocol + host + optional port)
# Example: http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie settings used by the server to control cookie behaviour
# COOKIE_SECURE: 'true' | 'false' | unset (defaults to true in production)
# COOKIE_SAME_SITE: 'lax' | 'strict' | 'none' (server will choose sensible default when unset)
# COOKIE_DOMAIN: optional domain to scope cookies (e.g. .example.com)
COOKIE_SECURE=unset
COOKIE_SAME_SITE=unset
COOKIE_DOMAIN=

# Proxy and rate limiting
# TRUST_PROXY can be '1', a number of trusted hops, or a provider name (e.g. 'cloudflare')
TRUST_PROXY=1

# Rate limit tuning (backend)
RATE_LIMIT_SEMI_DYNAMIC_POINTS=1000
RATE_LIMIT_SEMI_DYNAMIC_DURATION=60
RATE_LIMIT_DYNAMIC_POINTS=100
RATE_LIMIT_DYNAMIC_DURATION=60


# Metrics & Monitoring (for production)
EXPOSE_METRICS=true
METRICS_PORT=9090
