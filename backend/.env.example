# Database
MONGODB_URI=mongodb://localhost:27017/your_database

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Environment
NODE_ENV=development
PORT=5000

# Redis (required for distributed cache + rate limiting)
# Option A: Direct Redis URL (self-hosted / managed Redis)
# REDIS_URL=redis://localhost:6379

# Option B: Upstash REST credentials (auto-converted to rediss:// at runtime)
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Cache tuning (deployment)
# fresh cache TTL is configured in route middleware (e.g. cacheMiddleware(60))
# stale window serves old value briefly while next request refreshes key
CACHE_STALE_SECONDS=30
# jitter spreads expirations to reduce cache stampede across pods/instances
CACHE_TTL_JITTER_SECONDS=10
# SCAN count used for invalidation pattern scans (higher = faster, more CPU)
CACHE_SCAN_COUNT=500

# Logging
LOG_LEVEL=info

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Metrics & Monitoring (for production)
EXPOSE_METRICS=true
METRICS_PORT=9090
