FROM grafana/agent:latest

# Copy production configuration
COPY grafana-agent-config.prod.yaml /etc/grafana-agent.yaml

# Create log directory
RUN mkdir -p /tmp/grafana-agent-positions

# Expose metrics and logs endpoints
EXPOSE 8080 3100 12345

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/-/healthy || exit 1

# Run agent with config
CMD ["-config.file=/etc/grafana-agent.yaml", "-server.http.address=0.0.0.0:8080"]
